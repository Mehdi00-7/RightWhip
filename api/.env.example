# PostgreSQL connection string
DATABASE_URL=postgresql://autotrail:autotrail_dev@localhost:5432/autotrail

# Secret used to sign auth JWTs — any long random string (openssl rand -hex 32)
JWT_SECRET=change-me

# Groq API key for natural-language search + price summaries (https://console.groq.com)
# Optional: without it, those features degrade gracefully instead of erroring.
GROQ_API_KEY=

# Deployed frontend origin, added to the CORS allow-list (optional in local dev)
FRONTEND_ORIGIN=
