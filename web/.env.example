# Browser-facing API URL — used for <img> tags that load straight from the API.
# Must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-to-server API URL — used by Server Components and the /api rewrite proxy.
# In local dev this is the same as above; in a containerised deploy it differs
# (e.g. the Docker Compose service name, http://api:8000).
API_URL=http://localhost:8000
